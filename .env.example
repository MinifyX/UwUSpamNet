# Image tag to run.
SPAMNET_VERSION=latest
# Where the port is published on the host. Keep it on loopback behind a reverse proxy.
SPAMNET_BIND=127.0.0.1:8080
# true only behind your own reverse proxy: the client address is then the last X-Forwarded-For entry.
SPAMNET_TRUST_FORWARDED=false
SPAMNET_REPORTS_PER_DAY=5000
SPAMNET_REGISTRATIONS_PER_IP=5
